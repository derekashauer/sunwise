# Sunwise Environment Configuration
# Copy this to .env and fill in your values

# App
APP_ENV=production
APP_DEBUG=false
APP_URL=https://sunwise.dev

# JWT Secret (required in production; generate with: openssl rand -base64 32)
JWT_SECRET=change-this-to-a-random-string

# Encryption key for saved AI API keys (64 hex characters; generate with: openssl rand -hex 32)
ENCRYPTION_KEY=

# Claude API (optional server-wide fallback key)
CLAUDE_API_KEY=your-claude-api-key

# Cron secret (required; cron endpoints are closed without it)
# Call with header "X-Cron-Key: <secret>" or ?key=<secret>
CRON_SECRET=

# VAPID Keys for Push Notifications (base64url, from any VAPID key generator)
# Public key: 65-byte uncompressed point. Private key: 32-byte scalar.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Email (for magic links and the daily reminder)
MAIL_FROM=noreply@sunwise.dev
